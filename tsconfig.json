{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "allowJs": false,
    "sourceMap": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["./scripts/**/*.ts", "./Json/**/*.json"],
  "exclude": ["./node_modules", "./dist"]
}